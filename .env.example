# FTL host as seen from the container. For docker bridge networking on the
# same host as Pi-hole, 172.17.0.1 usually works; otherwise use the LAN IP.
PIHOLE_PROXY_TARGET=172.17.0.1
# FTL API port
PIHOLE_FTL_PORT=1010
# REQUIRED: the plain Pi-hole FTL API password (FTL v6 /admin settings).
# Server-side only — never shipped to the browser.
PIHOLE_API_PASSWORD=
# Optional: override the admin link in the app header.
# Defaults to http://<PIHOLE_PROXY_TARGET>:<PIHOLE_FTL_PORT>/admin, which works
# whenever the browser can reach that address (LAN deployments).
# Set it when the admin UI is exposed elsewhere, or when PIHOLE_PROXY_TARGET
# is a Docker-internal address (e.g. 172.17.0.1) the browser cannot reach.
# PUBLIC_PIHOLE_ADMIN=http://192.168.1.12:1010/admin
